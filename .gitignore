# Claude Code harness scratch state (agent worktrees, local session data).
# Not project content — see FIND-009 in docs/audit/S001_AUDIT_FINDINGS.md.
# Ngoại lệ: settings.json và hooks/ ĐƯỢC commit — chúng cấu hình SessionStart
# hook kiểm tra đồng bộ nhánh mặc định cho mọi session tương lai (DEC-118).
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/hooks/**

# --- Dữ liệu thật: KHÔNG commit ---
# File doanh số thô và file báo cáo chứa dữ liệu cá nhân khách hàng
# (tên, số điện thoại, địa chỉ). Xem governance/product/17_DATA_GOVERNANCE_PRIVACY.md.
data/samples/
data/uploads/
data/exports/

# S069 — Beta Operator UI: telemetry aggregate + feedback local, PRIVATE.
data/beta_feedback/
*.xlsx
!tests/fixtures/**/*.xlsx

# S071 — Shared Online Beta: run registry (SQLite) + artifact/upload state
# đều là dữ liệu runtime của một lần triển khai cụ thể, không phải nội dung
# repo. `data/tracking_live_tmp/` là capture Tracking tạm cho MỘT lần chạy
# (xoá ngay sau khi dùng — xem tools/tracking/live_pull.py), không bao giờ
# nên tồn tại lâu để mà commit.
data/web_runs/
data/tracking_live_tmp/
# TASK-PRA-001 — history store SQLite local/dev (production dùng PostgreSQL
# quản lý, xem ADR-108). Dữ liệu runtime của một máy cụ thể, không phải nội
# dung repo.
data/history/
*.jsonl.lock

# DEC-208/DEC-209 — bản chiếu HIỂN THỊ `catalog_display` (mã Tracking →
# model/hãng/nhóm hàng) và file trạng thái ghi cạnh nó. Cả hai là cache runtime
# của MỘT lần chạy báo cáo cụ thể, sống trên đĩa ephemeral ở production
# (xem docstring `app/web/catalog_display.py`), không phải dữ liệu repo — khác
# `mappings.jsonl` (log quyết định Product Identity, dữ liệu THẬT, có commit).
data/product_identity/tracking_display.json
data/product_identity/tracking_display.status.json

